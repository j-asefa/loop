FROM docker:28-cli AS docker-cli
FROM node:24-bookworm-slim AS runtime-build
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY scripts/compile-runtime.mjs scripts/compile-runtime.mjs
COPY runtime/ runtime/
RUN node scripts/compile-runtime.mjs /compiled-runtime

FROM node:24-bookworm-slim
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=runtime-build /compiled-runtime/ /runtime/
CMD ["node", "/runtime/broker.mjs"]
