{
  "name": "@j-asefa/loop",
  "version": "0.1.0",
  "description": "A durable, phone-first agent workspace",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "node scripts/build.mjs",
    "build:image": "node scripts/build-image.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "check": "node scripts/check.mjs",
    "format": "prettier --write \"{src,test,scripts}/**/*.{ts,tsx,js,jsx,mjs,cjs}\"",
    "test": "node scripts/test-runner.mjs vitest",
    "backup": "node --env-file=.env scripts/backup.mjs",
    "test:native": "node scripts/test-runner.mjs native",
    "test:all": "npm test && npm run test:native",
    "prepack": "npm run build",
    "test:browser:acp": "node scripts/heavy-command.mjs scripts/acp-deterministic-browser.mjs",
    "smoke:fleet": "node scripts/heavy-command.mjs scripts/fleet-browser-smoke.mjs",
    "smoke:companion": "node scripts/heavy-command.mjs scripts/companion-browser-smoke.mjs",
    "smoke:cards": "node scripts/heavy-command.mjs --import tsx scripts/cards-browser-smoke.mjs && node scripts/heavy-command.mjs --import tsx scripts/cards-content-browser.mjs && node scripts/heavy-command.mjs scripts/cards-window-browser.mjs",
    "smoke:feed-events": "node scripts/heavy-command.mjs --import tsx scripts/feed-websocket-smoke.mjs && node scripts/heavy-command.mjs --import tsx scripts/personal-files-events-smoke.mjs",
    "smoke:package": "node scripts/heavy-command.mjs scripts/package-smoke.mjs",
    "smoke:history": "node scripts/heavy-command.mjs scripts/conversation-history-smoke.mjs",
    "smoke:design": "node scripts/design-browser-smoke.mjs && node scripts/heavy-command.mjs scripts/approval-layout-browser.mjs",
    "smoke:math": "node scripts/heavy-command.mjs scripts/math-browser-smoke.mjs",
    "smoke:workspace": "node scripts/heavy-command.mjs scripts/workspace-lifecycle-smoke.mjs",
    "smoke:html": "node scripts/heavy-command.mjs scripts/html-preview-smoke.mjs",
    "smoke:pulls": "node scripts/heavy-command.mjs scripts/pull-requests-smoke.mjs",
    "smoke:social": "node scripts/heavy-command.mjs scripts/social-browser-smoke.mjs",
    "smoke:reconnect": "node scripts/heavy-command.mjs scripts/reconnect-browser-smoke.mjs",
    "smoke:fleet-controls": "node scripts/heavy-command.mjs scripts/fleet-controls-browser-smoke.mjs",
    "smoke:fleet-traces": "node scripts/heavy-command.mjs scripts/fleet-traces-browser-smoke.mjs",
    "smoke:fleet-commands": "node scripts/heavy-command.mjs scripts/fleet-command-browser-smoke.mjs",
    "feeds:check": "node --import tsx scripts/feed-liveness.mjs",
    "openapi": "node --import tsx scripts/openapi.mjs",
    "openapi:check": "npm run openapi -- --check",
    "cards:example": "node --import tsx examples/cards-sync.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j-asefa/loop.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bugs": {
    "url": "https://github.com/j-asefa/loop/issues"
  },
  "homepage": "https://github.com/j-asefa/loop#readme",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.0",
    "@anthropic-ai/sdk": "^0.128.0",
    "@huggingface/transformers": "4.3.0",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.20.0",
    "better-auth": "^1.7.5",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "dompurify": "^3.4.15",
    "express": "^5.2.1",
    "ipaddr.js": "^2.5.0",
    "katex": "^0.16.47",
    "lucide-react": "^1.47.0",
    "marked": "^16.4.2",
    "mermaid": "^12.0.0",
    "multer": "^2.4.0",
    "openai": "^7.22.0",
    "qrcode-terminal": "0.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tsx": "^4.23.15",
    "undici": "^8.11.0",
    "web-push": "^3.6.7",
    "ws": "8.21.3",
    "yaml": "^2.8.2",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "@types/qrcode-terminal": "0.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "8.18.1",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "0.28.2",
    "prettier": "3.9.8",
    "rolldown": "1.2.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "private": true,
  "bin": {
    "loop": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "dist",
    "migrations",
    "runtime",
    "docs",
    "README.md",
    "npm-shrinkwrap.json",
    "native",
    "deployment",
    "scripts/heavy-supervisor.py"
  ]
}
