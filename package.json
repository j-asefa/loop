{
  "name": "loop",
  "version": "0.1.0",
  "description": "A durable, phone-first agent workspace",
  "main": "index.js",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node --env-file=.env --import tsx src/server/serve.ts",
    "worker": "node --env-file=.env --import tsx src/server/worker.ts",
    "ui": "vite --host 0.0.0.0",
    "build": "node scripts/build.mjs",
    "build:image": "node scripts/build-image.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-runner.mjs vitest",
    "start": "node --import tsx src/server/serve.ts",
    "serve": "node scripts/serve.mjs",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "backup": "node --env-file=.env scripts/backup.mjs",
    "smoke:journey": "node scripts/browser-journey.mjs",
    "test:native": "node scripts/test-runner.mjs native",
    "test:all": "npm test && npm run test:native",
    "prepack": "npm run build",
    "test:browser:acp": "node scripts/acp-deterministic-browser.mjs",
    "smoke:companion": "node scripts/companion-browser-smoke.mjs",
    "smoke:cards": "node --import tsx scripts/cards-browser-smoke.mjs && node --import tsx scripts/cards-content-browser.mjs && node scripts/cards-window-browser.mjs",
    "smoke:package": "node scripts/package-smoke.mjs",
    "smoke:history": "node scripts/conversation-history-smoke.mjs",
    "smoke:design": "node scripts/design-browser-smoke.mjs && node scripts/approval-layout-browser.mjs",
    "smoke:workspace": "node scripts/workspace-lifecycle-smoke.mjs",
    "smoke:html": "node scripts/html-preview-smoke.mjs",
    "smoke:pulls": "node scripts/pull-requests-smoke.mjs",
    "smoke:social": "node scripts/social-browser-smoke.mjs",
    "smoke:reconnect": "node scripts/reconnect-browser-smoke.mjs",
    "feeds:check": "node --import tsx scripts/feed-liveness.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j-asefa/loop.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/j-asefa/loop/issues"
  },
  "homepage": "https://github.com/j-asefa/loop#readme",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.0",
    "@anthropic-ai/sdk": "^0.128.0",
    "@huggingface/transformers": "4.3.0",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.20.0",
    "better-auth": "^1.7.5",
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.4.15",
    "express": "^5.2.1",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.47.0",
    "marked": "^16.4.2",
    "mermaid": "^12.0.0",
    "multer": "^2.4.0",
    "openai": "^7.22.0",
    "qrcode-terminal": "0.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "undici": "^8.11.0",
    "web-push": "^3.6.7",
    "ws": "8.21.3",
    "yaml": "^2.8.2",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "@types/qrcode-terminal": "0.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "8.18.1",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "0.28.2",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "private": true,
  "bin": {
    "loop": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "dist",
    "migrations",
    "runtime",
    "docs",
    "README.md",
    "npm-shrinkwrap.json",
    "native",
    "deployment"
  ]
}
