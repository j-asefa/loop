LOOP_URL=http://localhost:3000
PORT=3000
LOOP_DATA_DIR=./data
# A personal workspace opens directly. Set multi-user for separate Loop accounts.
LOOP_AUTH_MODE=single-user
# When selecting one of several existing accounts:
# LOOP_SINGLE_USER_EMAIL=you@example.com
# Remote single-user access requires an authenticated proxy that overwrites
# X-Loop-Gateway-Token with this private value (at least 32 random characters).
# LOOP_GATEWAY_TOKEN=
# Direct Node binds to loopback. Compose sets these for its loopback-published port.
# LOOP_LISTEN_HOST=127.0.0.1
# LOOP_LOOPBACK_PROXY=0
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
LOOP_ENCRYPTION_KEY=replace-with-64-hex-characters
# MCP tool calls can run for five minutes by default. Positive milliseconds.
# LOOP_MCP_TOOL_TIMEOUT_MS=300000
# Optional external HTTPS proxy: set the actual public origin in LOOP_URL.
# LOOP_BEHIND_PROXY=1
# LOOP_HOST=loop.example.com
# LOOP_BIND_ADDRESS=127.0.0.1
# Optional Loop identity provider (not model authorization)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional OpenAI embedding model. Local semantic search requires no provider key.
LOOP_EMBEDDING_MODEL=text-embedding-3-small
# Deploy behind HTTPS. No provider keys are committed or required to boot.
