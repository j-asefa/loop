LOOP55_URL=http://localhost:3000
PORT=3000
LOOP55_DATA_DIR=./data
# A personal workspace opens directly. Set multi-user for separate Loop55 accounts.
LOOP55_AUTH_MODE=single-user
# When selecting one of several existing accounts:
# LOOP55_SINGLE_USER_EMAIL=you@example.com
# Remote single-user access requires an authenticated proxy that overwrites
# X-Loop55-Gateway-Token with this private value (at least 32 random characters).
# LOOP55_GATEWAY_TOKEN=
# Direct Node binds to loopback. Compose sets these for its loopback-published port.
# LOOP55_LISTEN_HOST=127.0.0.1
# LOOP55_LOOPBACK_PROXY=0
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
LOOP55_ENCRYPTION_KEY=replace-with-64-hex-characters
# Generate with node scripts/setup.mjs. Private broker authentication, not a provider key.
LOOP55_RUNTIME_TOKEN=replace-with-at-least-32-random-characters
# Compose supplies the internal broker URL. Direct Node deployments must configure it.
# LOOP55_RUNTIME_URL=http://runtime-broker:3100
# MCP tool calls can run for five minutes by default. Positive milliseconds.
# LOOP55_MCP_TOOL_TIMEOUT_MS=300000
# Optional external HTTPS proxy: set the actual public origin in LOOP55_URL.
# LOOP55_BEHIND_PROXY=1
# LOOP55_HOST=loop55.example.com
# LOOP55_BIND_ADDRESS=127.0.0.1
# Optional Loop55 identity provider (not model authorization)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional OpenAI embedding model. Local semantic search requires no provider key.
LOOP55_EMBEDDING_MODEL=text-embedding-3-small
# Explicitly allowed private runtime origins, for example an SSH tunnel:
# LOOP55_ALLOWED_RUNTIME_ORIGINS=http://127.0.0.1:3310
# Direct Codex app-server tunnel uses its WebSocket origin instead:
# LOOP55_ALLOWED_RUNTIME_ORIGINS=http://127.0.0.1:3310,ws://127.0.0.1:3311
# Deploy behind HTTPS. No provider keys are committed or required to boot.
