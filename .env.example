LOOP_URL=http://localhost:3000
PORT=3000
LOOP_DATA_DIR=./data
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
LOOP_ENCRYPTION_KEY=replace-with-64-hex-characters
# Generate with node scripts/setup.mjs. Private broker authentication, not a provider key.
LOOP_RUNTIME_TOKEN=replace-with-at-least-32-random-characters
# Compose supplies the internal broker URL. Direct Node deployments must configure it.
# LOOP_RUNTIME_URL=http://runtime-broker:3100
# Optional external HTTPS proxy: set the actual public origin in LOOP_URL.
# LOOP_BEHIND_PROXY=1
# LOOP_HOST=loop.example.com
# LOOP_BIND_ADDRESS=127.0.0.1
# Optional Loop identity provider (not model authorization)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional semantic retrieval; requires an OpenAI connection
LOOP_EMBEDDING_MODEL=text-embedding-3-small
# Deploy behind HTTPS. No provider keys are committed or required to boot.
