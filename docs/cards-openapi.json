  "securitySchemes": {
   "CardBearer": {
    "type": "http",
    "scheme": "bearer",
    "bearerFormat": "loop_card_…",
    "description": "Read routes only. results:read permits Results; cards:read permits Results, Saved and Sent. Never send tokens in URLs."
   },
   "OwnerSession": {
    "type": "apiKey",
    "in": "header",
    "name": "Cookie",
    "description": "Complete Cookie header from the authenticated Loop owner session, including cookie names. Preserve the deployment's names and values (HTTPS uses the __Secure- prefix). Browsers attach their cookie jar automatically; non-browser clients supply the complete header value."
   },
   "PairedDevice": {
    "type": "apiKey",
    "in": "header",
    "name": "Cookie",
    "description": "Complete Cookie header from the paired device session, including cookie names. Preserve the deployment's names and values (__Host-loop on HTTPS, loop_local on local HTTP, with an installation suffix for isolated previews). Browsers attach their cookie jar automatically; non-browser clients supply the complete header value. Management writes also require PairedCsrf."
   },
   "PairedCsrf": {
    "type": "apiKey",
    "in": "header",
    "name": "x-loop-csrf",
    "description": "Required together with PairedDevice for management writes. Read the csrf value from the authenticated /session response. Also send the matching workspace Origin header."
   }
  }
