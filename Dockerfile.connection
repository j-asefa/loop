# The Docker companion's connection service: the relay and cloudflared only.
# It needs no provider homes, projects or Docker socket, and is replaced
# separately from the application container (see docs/server.md).
FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY tsconfig.json ./
COPY src ./src
COPY runtime/environment.mjs runtime/name-upgrade.ts ./runtime/
COPY scripts/build-connection.mjs ./scripts/
RUN node scripts/build-connection.mjs
RUN node dist/connection-daemon.bundle.mjs --install-helper /opt/loop55-tunnel

FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/dist/connection-daemon.bundle.mjs /opt/loop55-connection/connection.mjs
COPY --from=build /opt/loop55-tunnel /opt/loop55-tunnel
RUN chmod -R a+rX /opt/loop55-connection /opt/loop55-tunnel && mkdir -p /data/loop55-connection && chown node:node /data/loop55-connection && chmod 700 /data/loop55-connection
ENV NODE_ENV=production LOOP55_BAKED_HELPERS=/opt/loop55-tunnel
USER node
WORKDIR /data/loop55-connection
VOLUME ["/data/loop55-connection"]
HEALTHCHECK --interval=15s --timeout=5s --start-period=90s CMD ["node", "/opt/loop55-connection/connection.mjs", "--health", "--dir", "/data/loop55-connection"]
CMD ["node", "/opt/loop55-connection/connection.mjs", "--dir", "/data/loop55-connection"]
