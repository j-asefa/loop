FROM node:24-bookworm-slim AS build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends git openssl unzip python3 make g++ ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package*.json ./
RUN npm ci && npm cache clean --force
COPY . .
RUN npm run build \
    && node --input-type=module -e 'import { helper } from "./dist/tunnel.js"; await helper("/opt/loop-tunnel")' \
    && chmod -R a+rX /opt/loop-tunnel \
    && npm ci --prefix deployment/native --omit=dev \
    && npm prune --omit=dev \
    && npm cache clean --force

FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends git openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /app/dist/cli.js /usr/local/bin/loop \
    && mkdir -p /data/loop/provider-home /data/loop-connection /workspaces \
    && chown -R node:node /data /workspaces && chmod 700 /data/loop-connection
COPY --from=build /opt/loop-tunnel /opt/loop-tunnel
COPY --from=build --chown=node:node /app /app
ENV NODE_ENV=production LOOP_HOME=/data/loop HOME=/data/loop/provider-home LOOP_COMPANION_CONTAINER=1 LOOP_BAKED_HELPERS=/opt/loop-tunnel
ENV PATH=/app/deployment/native/node_modules/.bin:$PATH
USER node
WORKDIR /workspaces
VOLUME ["/data/loop", "/workspaces"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s CMD node /app/scripts/companion-health.mjs
CMD ["loop", "start", "--foreground", "--execution", "native", "--providers", "codex,claude,opencode,pi"]
